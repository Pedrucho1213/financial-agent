# Copia este archivo a .env y ajusta lo que necesites.

# Solo escucha en tu Mac; Tailscale lo publica de forma privada para tu iPhone.
HOST=127.0.0.1
PUERTO=8787
BASE_DATOS=./datos/finanzas.db
ZONA_HORARIA=America/Mexico_City
MONEDA=MXN

# Cuánto espera el iPhone a la IA (milisegundos). Si tarda más, la Mac contesta
# "anotado" y termina sola; a las preguntas se les da más tiempo.
ESPERA_REGISTRO_MS=5000
ESPERA_PREGUNTA_MS=30000

# Cualquier API compatible con OpenAI. Con Ollama:
IA_URL=http://localhost:11434/v1
IA_MODELO=gemma4:12b-it-qat
IA_API_KEY=ollama
OLLAMA_URL=http://localhost:11434
# Cuánto tiempo se queda el modelo en memoria después de usarlo. Ollama 0.32.5 todavía usa
# OLLAMA_KEEP_ALIVE de su servicio (5 minutos por omisión); abrir el Atajo lo vuelve a cargar.
IA_MANTENER_CARGADO=5m
# Cuánto razona el modelo: none, low, medium, high o no (no mandarlo). Con gemma4, none.
IA_RAZONAMIENTO=none
# Cuántos usuarios atiende la IA a la vez; tiene que coincidir con OLLAMA_NUM_PARALLEL del servicio
# de Ollama. Los dictados de un mismo usuario siempre van de uno en uno. En la M3 Max se queda en 1:
# con 2 o 3 el modelo ocupa 1 a 2 GB más y la primera vez de cada usuario sube a 15-30 s, a cambio de
# que con 3 personas dictando juntas la última espere 6 s en vez de 8 (bun run eval:paralelo).
IA_PARALELO=1
# Desarrollo: interruptor de la IA en Ajustes › Sistema (solo la cuenta dueña). Ahí se elige si el modelo
# se queda siempre en memoria (por omisión) o se suelta tras unos minutos sin uso, y se enciende o apaga
# a mano; lo elegido manda sobre IA_MANTENER_CARGADO y OLLAMA_KEEP_ALIVE. Poner 0 antes de abrir al público.
IA_INTERRUPTOR=1
# Contacto que se le da a Apple en las notificaciones push (mailto: o https:). Sin valor, la dirección
# pública con que se abrió la app (https), o mailto:finanzas@example.com si no hay.
# PUSH_CONTACTO=mailto:tu-correo@ejemplo.com
